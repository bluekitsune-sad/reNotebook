FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# --- Stage 1: Install dependencies ---
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/sync-core/package.json ./packages/sync-core/
COPY packages/validation/package.json ./packages/validation/
COPY apps/server/package.json ./apps/server/
RUN pnpm install --frozen-lockfile --filter @synced-notepad/server...

# --- Stage 2: Build ---
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/server/node_modules ./apps/server/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/sync-core/node_modules ./packages/sync-core/node_modules
COPY --from=deps /app/packages/validation/node_modules ./packages/validation/node_modules
COPY packages/shared ./packages/shared
COPY packages/sync-core ./packages/sync-core
COPY packages/validation ./packages/validation
COPY apps/server ./apps/server
RUN pnpm --filter @synced-notepad/shared build && \
    pnpm --filter @synced-notepad/validation build && \
    pnpm --filter @synced-notepad/sync-core build && \
    pnpm --filter @synced-notepad/server build

# --- Stage 3: Production ---
FROM node:22-alpine AS production
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup
WORKDIR /app
RUN apk add --no-cache curl

COPY --from=build --chown=appuser:appgroup /app/node_modules ./node_modules
COPY --from=build --chown=appuser:appgroup /app/apps/server/node_modules ./apps/server/node_modules
COPY --from=build --chown=appuser:appgroup /app/apps/server/src ./apps/server/src
COPY --from=build --chown=appuser:appgroup /app/apps/server/package.json ./apps/server/
COPY --from=build --chown=appuser:appgroup /app/packages/shared/src ./packages/shared/src
COPY --from=build --chown=appuser:appgroup /app/packages/shared/package.json ./packages/shared/
COPY --from=build --chown=appuser:appgroup /app/packages/sync-core/src ./packages/sync-core/src
COPY --from=build --chown=appuser:appgroup /app/packages/sync-core/package.json ./packages/sync-core/
COPY --from=build --chown=appuser:appgroup /app/packages/validation/src ./packages/validation/src
COPY --from=build --chown=appuser:appgroup /app/packages/validation/package.json ./packages/validation/

USER appuser
ENV NODE_ENV=production
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:3001/api/health || exit 1

CMD ["node", "apps/server/src/index.js"]
