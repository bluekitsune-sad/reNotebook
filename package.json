{
  "name": "synced-notepad",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "pnpm install && turbo build",
    "deploy": "turbo build && docker compose up -d --build",
    "backup": "mongodump --uri=\"$MONGODB_URI\" --archive=\"backup_$(date +%Y%m%d_%H%M%S).archive\""
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.52.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.4.0",
    "turbo": "^2.4.0"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.0"
}
