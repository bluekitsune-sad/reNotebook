FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# --- Stage 1: Install dependencies ---
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/sync-core/package.json ./packages/sync-core/
COPY packages/validation/package.json ./packages/validation/
COPY apps/web/package.json ./apps/web/
RUN pnpm install --frozen-lockfile --filter @synced-notepad/web...

# --- Stage 2: Build ---
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/sync-core/node_modules ./packages/sync-core/node_modules
COPY --from=deps /app/packages/validation/node_modules ./packages/validation/node_modules
COPY packages/shared ./packages/shared
COPY packages/sync-core ./packages/sync-core
COPY packages/validation ./packages/validation
COPY apps/web ./apps/web
COPY apps/web/next.config.mjs ./apps/web/next.config.mjs
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm --filter @synced-notepad/shared build && \
    pnpm --filter @synced-notepad/validation build && \
    pnpm --filter @synced-notepad/sync-core build && \
    pnpm --filter @synced-notepad/web build

# --- Stage 3: Production (standalone) ---
FROM node:22-alpine AS production
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

COPY --from=build --chown=appuser:appgroup /app/apps/web/.next/standalone ./
COPY --from=build --chown=appuser:appgroup /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=appuser:appgroup /app/apps/web/public ./apps/web/public

USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1

CMD ["node", "apps/web/server.js"]
