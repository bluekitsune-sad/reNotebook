# ============================================
# Synced Notepad — Production Environment
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# MongoDB
MONGODB_URI=mongodb://admin:CHANGE_ME@mongodb:27017/synced-notepad?authSource=admin
MONGO_USERNAME=admin
MONGO_PASSWORD=CHANGE_ME

# JWT — Generate with: openssl rand -base64 64
# WARNING: You MUST change this before deploying to production.
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING

# Server
PORT=3001
NODE_ENV=production

# CORS
CORS_ORIGIN=https://your-domain.com

# Logging
LOG_LEVEL=warn

# Web
NEXT_PUBLIC_API_URL=https://your-domain.com

# MongoDB Express (disable in production)
# ME_EXPRESS_USER=admin
# ME_EXPRESS_PASSWORD=CHANGE_ME

# S3 Backup (optional)
# S3_BUCKET=your-backup-bucket
# S3_PREFIX=synced-notepad-backups
