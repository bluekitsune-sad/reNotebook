{
  "name": "synced-notepad",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "pnpm install && turbo build",
    "deploy": "turbo build && docker compose up -d --build",
    "backup": "mongodump --uri=\"$MONGODB_URI\" --archive=\"backup_$(date +%Y%m%d_%H%M%S).archive\""
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "prettier": "^3.4.0",
    "eslint": "^9.18.0",
    "@eslint/js": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "@playwright/test": "^1.52.0"
  },
  "packageManager": "pnpm@9.15.0"
}
