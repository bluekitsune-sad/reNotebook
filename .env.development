# MongoDB
MONGODB_URI=mongodb://localhost:27017/synced-notepad
MONGO_USERNAME=admin
MONGO_PASSWORD=password

# JWT
JWT_SECRET=dev-secret

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# MongoDB Express
ME_EXPRESS_USER=admin
ME_EXPRESS_PASSWORD=admin
